# =============================================================================
# Goring - WebSocket Signaling Server Configuration
# =============================================================================
# Copy this file to .env and modify values as needed
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# HTTP server port
PORT=8080

# Unique server instance identifier (used for horizontal scaling)
# If not set, defaults to hostname
SERVER_ID=server-1

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# JWT secret key for token validation (HMAC-SHA256)
# IMPORTANT: Change this in production!
JWT_SECRET=dev-secret-change-in-production

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------

# Redis server address (host:port)
REDIS_ADDR=localhost:6379

# Redis authentication password (leave empty if no auth)
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Docker Compose Overrides (only used when running with docker-compose)
# -----------------------------------------------------------------------------

# These are automatically set in docker-compose.yml but can be overridden:
# REDIS_ADDR=redis:6379  (uses Docker DNS when running in containers)

# -----------------------------------------------------------------------------
# Push Notifications (Optional)
# Configure FCM and/or APNs to notify offline callees.
# If neither is set, calls to offline users return a user_offline error.
# -----------------------------------------------------------------------------

# FCM - Firebase Cloud Messaging v1 API (Android)
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...",...}
# FCM_PROJECT_ID=my-firebase-project

# APNs - Apple Push Notification service VoIP (iOS) — certificate-based auth
# APNS_CERT_PATH=/etc/ssl/apns/voip_certificate.p12
# APNS_CERT_PASSPHRASE=your-certificate-passphrase
# APNS_BUNDLE_ID=com.example.app
# APNS_PRODUCTION=false
